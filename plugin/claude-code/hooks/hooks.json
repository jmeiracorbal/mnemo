{
  "description": "mnemo persistent memory hooks — context injection",
  "hooks": {
    "SessionStart": [
      {"matcher":"startup","hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh","timeout":10,"statusMessage":"Loading mnemo memory..."}]},
      {"matcher":"resume","hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh","timeout":10,"statusMessage":"Loading mnemo memory..."}]},
      {"matcher":"clear","hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh","timeout":10,"statusMessage":"Loading mnemo memory..."}]},
      {"matcher":"compact","hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/scripts/post-compact-resume.sh","timeout":10,"statusMessage":"Recovering mnemo context after compaction..."}]}
    ],
    "UserPromptSubmit": [
      {"matcher":"","hooks":[{"type":"command","command":"${CLAUDE_PLUGIN_ROOT}/scripts/user-prompt-submit.sh","timeout":5}]}
    ]
  }
}
